#!/bin/sh
# Front door for the dotfiles repo. `config <sub>` runs the sibling
# config-<sub> when one exists, so new tooling lands beside this file, and
# passes everything else to git on the bare repo, so every git verb keeps
# working exactly as the old alias did.
set -eu

self=$(readlink -f "$0")
here=$(dirname "$self")

# A leading -- sends everything after it straight to git, skipping the
# sibling lookup. It is the escape hatch that makes a config-<sub> sharing a
# git verb safe: `config help` lists these utilities, `config -- help`
# reaches git. The separator is consumed, so `config -- log <path>` stays
# `git log <path>` rather than becoming a pathspec.
if [ "${1:-}" = "--" ]; then
    shift
    exec git --git-dir="$HOME/.cfg" --work-tree="$HOME" "$@"
fi

# --help and -h are the two spellings people try before `config help`, and
# git answers both with its own usage, which never mentions these utilities.
case ${1:-} in
    --help|-h) exec "$here/config-help" ;;
esac

if [ "$#" -gt 0 ]; then
    case $1 in
        ''|-*|*[!A-Za-z0-9-]*) ;;
        *) if [ -x "$here/config-$1" ]; then sub=$1; shift; exec "$here/config-$sub" "$@"; fi ;;
    esac
fi

exec git --git-dir="$HOME/.cfg" --work-tree="$HOME" "$@"
