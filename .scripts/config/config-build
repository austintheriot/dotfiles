#!/bin/sh
# help: Build every workspace crate and install its stamped binary
#
# Builds every member of the crates/ workspace and installs each one's binary
# with the stamp pre-push compares against embedded inside it. Run this after
# editing any crate; pre-push never compiles.
#
# The stamp is embedded rather than written to a file beside the binary. Two
# independent paths meant overriding one and defaulting the other freshened a
# stamp the running binary never came from, and a foreign config-manifest
# earlier on PATH passed the check too. A stamp inside the binary is the
# binary's own claim about what it was built from.
#
# A crate with no src/main.rs is a library: it has no binary to install or to
# stamp-check at the push gate, only source that other crates depend on and
# that is already covered by their own stamps. It is still compiled, by the
# one cargo invocation below, so a library-only crate's compile errors are
# caught here rather than only inside a dependent's build.
#
# usage: config build
#
# Takes no options.
#
# Environment:
#   DOTFILES_ROOT      Repo root. Default $HOME.
#   CARGO_TARGET_DIR   Default $HOME/.cache/config-manifest/target, so no
#                      target/ lands inside the tracked tree.
#   CONFIG_BIN_DIR     Where to install binaries. Default $HOME/.local/bin.

set -eu

. "$(dirname "$(readlink -f "$0")")/usage.sh"
usage_if_requested "${1:-}"

ROOT=${DOTFILES_ROOT:-$HOME}
WORKSPACE_DIR="$ROOT/crates"
BIN_DIR=${CONFIG_BIN_DIR:-$HOME/.local/bin}
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$HOME/.cache/config-manifest/target}"

# One invocation, one snapshot. Re-invoking per crate would read the worktree
# several times, so crate A could be stamped from one state and crate B from
# another.
# `--quiet` only when nobody is watching.
#
# `config init: [4/5] build and install the stamped binary` printed one line
# and then nothing for minutes on a fresh machine. Not buffering: config-init
# runs this script with no redirection, and `cargo build --quiet` suppresses
# the per-crate "Compiling ..." lines, which are the only progress a cold
# compile of six crates emits.
#
# The flag was still doing real work, measured before changing it. A warm
# rebuild of one crate prints both a "Compiling" and a "Finished" line
# without it and nothing with it, so dropping it unconditionally makes the
# no-op rebuild that every `config init` re-run performs noisy, and adds
# noise to eight CI legs.
#
# Unquoted on purpose: this is a word to pass or nothing at all, and the
# empty-string case must expand to zero arguments rather than one empty one.
if [ -t 1 ]; then
    quiet=''
else
    quiet='--quiet'
fi

stamps=$("$ROOT/.scripts/config/config-stamp")

mkdir -p "$BIN_DIR"

# The `|| exit 1` after the loop matters: the pipeline runs its body in a
# subshell, so a `cargo build` failure or an internal `exit` inside it would
# otherwise not stop this script. Verified elsewhere in this repo (see
# tests/pre-push) that an `exit 1` inside a piped `while` does make the
# pipeline itself return non-zero, which the `||` here catches.
printf '%s\n' "$stamps" | while IFS=' ' read -r member stamp; do
    [ -n "$member" ] || continue

    # option_env! reads this at compile time, so changing it rebuilds the
    # binary. Every member is built here, library-only ones included, so a
    # library's compile errors surface at `config build` rather than only
    # inside whichever binary depends on it.
    CONFIG_MANIFEST_STAMP="$stamp" \
        cargo build --release --locked $quiet \
            --manifest-path "$WORKSPACE_DIR/Cargo.toml" -p "$member" \
        || exit 1

    if [ ! -f "$WORKSPACE_DIR/$member/src/main.rs" ]; then
        printf 'config-build: %s is a library, nothing to install\n' "$member"
        continue
    fi

    cp "$CARGO_TARGET_DIR/release/$member" "$BIN_DIR/$member"

    # Paying any first-run cost here rather than in a hook, and reporting the
    # stamp the installed binary actually carries rather than the one just
    # asked for, so a build that failed to pick the variable up is visible
    # here.
    built=$("$BIN_DIR/$member" --stamp)

    printf 'config-build: installed %s (stamp %s)\n' "$BIN_DIR/$member" "$built"
done || exit 1
