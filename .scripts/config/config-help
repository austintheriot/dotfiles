#!/bin/sh
# help: List the config subcommands and what each one does
#
# The listing is generated by reading the `# help:` line out of every
# config-<sub> beside this script, so a new utility documents itself the
# moment it lands here. A hand-written list would be a second copy of the
# same facts, and the one that nobody edits is the one that goes stale.
set -eu

self=$(readlink -f "$0")
here=$(dirname "$self")

printf 'usage: config <command> [args]\n'
printf '       config <git-command> [args]\n\n'
printf 'Commands:\n'

for script in "$here"/config-*; do
    [ -f "$script" ] || continue
    name=${script##*/config-}
    description=$(sed -n 's/^# help: //p' "$script" | head -1)
    [ -n "$description" ] || description='(undocumented)'
    printf '  %-14s %s\n' "$name" "$description"
done

printf '\nAny other verb is passed to git on the bare repo at ~/.cfg, so every\n'
printf 'git command works: config status, config add <path>, config commit.\n'
