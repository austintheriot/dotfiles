#!/bin/sh
# help: List the config subcommands and what each one does
#
# usage: config help
#
# Lists every subcommand with its one-line description. Takes no options:
# `config help --help` and `config --help` both print this text, and both
# then print the listing, because the listing is what help is for.
#
# For the flags a single subcommand takes, ask that subcommand:
# `config test --help`.
# ---
# The paragraphs below are for whoever edits this file rather than whoever
# runs it, so they sit after the `# ---` terminator that usage.sh honors.
#
# A shim, deliberately. Every decision lives in config-cli, and this file
# exists so `config help` resolves through the dispatcher rather than
# falling through to git: .scripts/config/config finds a verb only by testing
# `[ -x "$here/config-<verb>" ]` and otherwise execs git, with no config-cli
# fallback, so deleting this file would make `config help` mean `git help`.
#
# The `# help:` line above is also what this shim's own row in the listing is
# built from, because the listing asks each sibling for its description and
# usage.sh answers --describe by reading that line. Deleting the line would
# drop `help` out of its own listing.
#
# CONFIG_SUBCOMMAND_DIR names the directory to enumerate, and it is exported
# here rather than defaulted in the binary alone because the listing has
# always resolved its siblings from this script's own $0. A copy of this
# shim run out of a fixture directory must list that directory's siblings,
# which is how config-usage.test.sh exercises the odd-shaped ones without
# leaving a stray config-* in the real .scripts/config that every other suite
# counts.
#
# --help is answered here rather than delegated, and it does not exit, unlike
# every sibling shim's usage_if_requested call: help is the one subcommand
# that does not stop at --help. Printing the block and exiting would hide the
# listing from `config --help`, which the dispatcher routes here and which
# readers expect to answer "what commands exist". So the block prints and the
# listing follows.
#
# Answered here rather than in config-cli so the block has exactly one home,
# this file's own `# usage:` header, read back by print_usage. A copy inside
# the binary would be the copy that drifts, and the same reasoning is why the
# listing asks its siblings instead of embedding them.
#
# --describe stops here too, so asking what this command does never runs it.
set -eu

self=$(readlink -f "$0")
here=$(dirname "$self")

. "$here/usage.sh"
case ${1:-} in
    --describe) print_describe "$self"; exit 0 ;;
    --help|-h) print_usage "$self"; printf '\n'; shift ;;
esac

CONFIG_SUBCOMMAND_DIR="$here"
export CONFIG_SUBCOMMAND_DIR

exec config-cli help "$@"
