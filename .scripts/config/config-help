#!/bin/sh
# help: List the config subcommands and what each one does
#
# usage: config help
#
# Lists every subcommand with its one-line description. Takes no options:
# `config help --help` and `config --help` both print this text, and both
# then print the listing, because the listing is what help is for.
#
# For the flags a single subcommand takes, ask that subcommand:
# `config test --help`.
#
# The listing is generated by asking each config-<sub> beside this script to
# describe itself, so a new utility documents itself the moment it lands here.
# A hand-written list would be a second copy of the same facts, and the one
# that nobody edits is the one that goes stale.
#
# Asked rather than read: the description used to come from a
# `sed -n 's/^# help: //p'` over the subcommand's source text, which assumed
# every subcommand is a readable text file. Against a compiled binary that sed
# prints "RE error: illegal byte sequence" to stderr and the pipeline still
# exits 0, so the listing lost the description and gained an error line
# without failing.
set -eu

self=$(readlink -f "$0")
here=$(dirname "$self")

# help is the one subcommand that does not exit on --help. Printing the block
# and stopping would hide the listing from `config --help`, which the
# dispatcher routes here and which readers expect to answer "what commands
# exist". The block prints first, then the listing.
. "$here/usage.sh"
case ${1:-} in
    --help|-h) print_usage; printf '\n' ;;
    --describe) print_describe; exit 0 ;;
esac

printf 'usage: config <command> [args]\n'
printf '       config <git-command> [args]\n\n'
printf 'Commands:\n'

for script in "$here"/config-*; do
    [ -f "$script" ] || continue
    name=${script##*/config-}
    # Only an executable sibling is reachable through the dispatcher, which
    # requires -x before it execs. A file that help lists but the dispatcher
    # will not run has no description to ask for, and asking anyway would put
    # a permission error in the column.
    description=''
    if [ -x "$script" ]; then
        description=$("$script" --describe 2>/dev/null | head -1) || description=''
    fi
    [ -n "$description" ] || description='(undocumented)'
    printf '  %-14s %s\n' "$name" "$description"
done

printf '\nRun `config <command> --help` for the flags a command takes.\n'
printf '\nAny other verb is passed to git on the bare repo at ~/.cfg, so every\n'
printf 'git command works: config status, config add <path>, config commit.\n'
