#!/bin/sh
# help: Finish a fresh clone: git config, hooks, toolchain, binary, deps
#
# usage: config init [-y|--yes] [-n|--dry-run]
#
# Takes a home that already has the bare repo checked out and finishes the
# job: sets the one git setting the bare-repo-over-home technique depends on,
# links the git hooks and puts `config` on PATH, installs the missing tracked
# dependencies, then builds and installs the stamped binary.
#
# This is the post-clone half of the bootstrap. setup.sh is the other half:
# it clones, picks the branch, checks out, and then runs this. On a machine
# that is already cloned, run this directly.
#
# Idempotent. Every step converges on a machine that is already set up, so
# re-running it after a pull is safe and is the intended way to pick up a new
# dependency.
#
# Options:
#   -y, --yes      Install without prompting per dependency. For Docker, CI,
#                  and a remote box with no one at the terminal.
#   -n, --dry-run  Print every step and change nothing.
#
# Environment:
#   DOTFILES_ROOT  Repo root. Default $HOME.
#
# ---
# Step order is a contract, not an accident, and the tests assert it. It
# encodes one rule: a thin shell layer installs the absolutely necessary
# components, then the Rust engine bootstraps everything else.
#
#   install-hooks first, because it is what puts `config` on PATH. A later
#   step, a later shell, or the reader's next command resolves `config`
#   through ~/.local/bin, and on a fresh machine nothing else has put it
#   there.
#
#   prereqs second. cc and rustup are the two dependencies the engine cannot
#   install, because installing anything is what the engine does and the
#   engine has to be compiled first. This is the shell layer, and
#   config-prereqs is deliberately the only one.
#
#   build third, compiling config-cli with the toolchain prereqs just placed.
#
#   install last, because it runs the engine, which needs the binary the
#   build step produced.
#
# BUILD BEFORE INSTALL is a correction, recorded because the previous order
# was hooks, install, build and its stated reasoning reads as sound: "install
# places the Rust toolchain that build then compiles with". That held while
# the deps engine was shell. It stopped holding when the engine became
# config-cli: the install step is `exec config-cli deps install`
# (config-install), and config-cli is what the build step PRODUCES, so
# install depended on the output of a step that ran after it. The two halves
# of the loop were each documented here without anyone noticing they closed.
#
# Reproduced against the README one-liner in clean debian:bookworm and
# ubuntu:24.04:
#   config init: [3/4] install the missing tracked dependencies
#   /root/.scripts/config/config-install: 13: exec: config-cli: not found
#
# Every step is delegated to the sibling config-<sub> rather than reimplemented
# here, so there is one place that knows how to install dependencies and one
# place that knows how to build the crate. This script owns the order and
# nothing else.
set -eu

self=$(readlink -f "$0")
here=$(dirname "$self")

. "$here/usage.sh"
usage_if_requested "${1:-}"

yes=0
dry_run=0
for arg in "$@"; do
    case "$arg" in
        -y|--yes) yes=1 ;;
        -n|--dry-run) dry_run=1 ;;
        *)
            printf 'config init: unknown argument: %s\n' "$arg" >&2
            printf 'config init: run `config init --help` for usage\n' >&2
            exit 2
            ;;
    esac
done

ROOT=${DOTFILES_ROOT:-$HOME}
git_dir="$HOME/.cfg"

# The install step places tools that a default non-login PATH does not carry,
# and the build step runs in the same process, so it has to be able to see
# them.
#
# rustup installs cargo into ~/.cargo/bin. Without this the run ended with
# "done, except the build step -- run `config build` once cargo is on PATH" on
# a machine where the install step had just installed rustup successfully: the
# toolchain existed and was invisible. The deps engine already prepends these
# two directories for exactly this reason, so a `command -v` check does not
# fail on the line after its own install succeeded; this is the same problem
# one level up, where an install and a build happen in one process.
#
# ~/.local/bin as well, because config-install-hooks puts `config` there and
# config-build installs config-cli there, and both are resolved by name
# afterwards.
# Remembered before the prepend below, because the closing hint has to answer
# "can the CALLER'S shell see config?" and not "can this script see it?". The
# prepend makes the answer always yes for this process, which would silence
# the hint exactly when it is needed.
caller_path=$PATH

PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
export PATH

step=0
announce() {
    step=$((step + 1))
    if [ "$dry_run" -eq 1 ]; then
        printf 'config init: [%d/5] would %s\n' "$step" "$1"
    else
        printf 'config init: [%d/5] %s\n' "$step" "$1"
    fi
}

# The bare repo is this script's one precondition. Checking it here names the
# problem where it can be fixed, rather than letting `git config` fail four
# lines down with a message about a directory the reader never typed.
if [ "$dry_run" -eq 0 ] && [ ! -d "$git_dir" ]; then
    printf 'config init: no bare repo at %s\n' "$git_dir" >&2
    printf 'config init: clone first, or run setup.sh, which does both\n' >&2
    exit 1
fi

# Without this, every untracked file in $HOME shows up in `config status`.
# That is what makes a bare repo over a home directory usable at all, and it
# is local to the repo, so a fresh clone does not carry it.
announce 'set status.showUntrackedFiles to no'
if [ "$dry_run" -eq 0 ]; then
    git --git-dir="$git_dir" config status.showUntrackedFiles no
fi

announce 'link the git hooks and put config on PATH'
if [ "$dry_run" -eq 0 ]; then
    "$here/config-install-hooks"
fi

# The shell layer. Fatal on failure, and it has to be: every step below
# needs the engine, and the engine cannot be compiled without these two.
# Continuing would reach config-install and reproduce
# "exec: config-cli: not found", which is a worse message for the same
# problem.
announce 'install the build toolchain (cc, rustup)'
if [ "$dry_run" -eq 0 ]; then
    prereq_status=0
    if [ "$yes" -eq 1 ]; then
        "$here/config-prereqs" --yes || prereq_status=$?
    else
        "$here/config-prereqs" || prereq_status=$?
    fi

    if [ "$prereq_status" -ne 0 ]; then
        printf '\nconfig init: the build toolchain step failed\n' >&2
        printf 'config init: the repo is cloned, the hooks are linked, and config is on PATH\n' >&2
        printf 'config init: cc and rustup are what everything below needs, so this stops here\n' >&2
        printf 'config init: fix that, then run:\n' >&2
        printf 'config init:   %s/config-prereqs && %s/config-build && %s/config-install\n' \
            "$here" "$here" "$here" >&2
        exit "$prereq_status"
    fi

    # rustup put cargo in ~/.cargo/bin, which was prepended above, but the
    # prepend happened before rustup existed. Re-resolving here is what lets
    # the build step below see a toolchain installed seconds ago in this same
    # process.
    hash -r 2>/dev/null || true
fi

# Third, not last. It produces config-cli, which the install step below execs.
#
# Fatal, unlike the old trailing build step. That one was allowed to fail
# because "a machine with no cargo is a real state" and nothing downstream
# needed the binary. Both halves changed: prereqs now guarantees cargo, and
# the install step below cannot run without the binary this produces, so a
# tolerated failure here would only defer the error to a worse message.
announce 'build and install the stamped binary'
if [ "$dry_run" -eq 0 ]; then
    build_status=0
    DOTFILES_ROOT="$ROOT" "$here/config-build" || build_status=$?

    if [ "$build_status" -ne 0 ]; then
        printf '\nconfig init: the build step failed\n' >&2
        printf 'config init: cc and rustup are installed, so this is a compile failure\n' >&2
        printf 'config init: config-cli is what the install step runs, so this stops here\n' >&2
        printf 'config init: fix it, then run:\n' >&2
        printf 'config init:   %s/config-build && %s/config-install\n' "$here" "$here" >&2
        exit "$build_status"
    fi
fi

# set -eu already aborts here on a non-zero install, and that is the right
# outcome: a bootstrap that installed nothing has not bootstrapped anything.
# What a bare abort does not do is tell the reader where they stand, and a
# bare root container reported eleven failures with no closing word on what
# had already worked or what to try next.
announce 'install the missing tracked dependencies'
if [ "$dry_run" -eq 0 ]; then
    install_status=0
    if [ "$yes" -eq 1 ]; then
        "$here/config-install" --yes || install_status=$?
    else
        "$here/config-install" || install_status=$?
    fi

    if [ "$install_status" -ne 0 ]; then
        printf '\nconfig init: the install step failed\n' >&2
        printf 'config init: the repo is cloned, the hooks are linked, and config is on PATH\n' >&2
        printf 'config init: fix the package manager, then run:\n' >&2
        printf 'config init:   %s/config-install\n' "$here" >&2
        printf 'config init: (or `config install`, once %s/.local/bin is on your PATH)\n' \
            "$HOME" >&2
        exit "$install_status"
    fi
fi

if [ "$dry_run" -eq 1 ]; then
    printf '\nconfig init: dry run, nothing was changed\n'
    exit 0
fi

printf '\nconfig init: done\n'

# No process can change the PATH of the shell that started it, so the shell
# that just ran this cannot see the newly linked `config` on its own.
#
# Reported from a bare container: "config init: done" followed immediately by
# "config: command not found". Reporting success and leaving the reader with
# an uncallable command is a dead end, so name the one line that fixes the
# current shell.
#
# Printed only when it is actually needed. On a machine where ~/.local/bin is
# already on PATH this is noise, and noise inside a success message is how
# real warnings come to be ignored.
case ":$caller_path:" in
    *":$HOME/.local/bin:"*) ;;
    *)
        printf 'config init: `config` is at %s/.local/bin, which this shell has not picked up.\n' \
            "$HOME"
        printf 'config init: for this shell:  export PATH="$HOME/.local/bin:$PATH"\n'
        printf 'config init: new shells get it from ~/.profile (bash, sh) or ~/.zshrc (zsh).\n'
        ;;
esac
