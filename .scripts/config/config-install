#!/bin/sh
# help: Install the dependencies the manifest names
#
# usage: config install [--dry-run] [--yes] [--only a,b]
#
# A thin wrapper around `config deps install`. Run `config deps install
# --help` for the full flag list.
set -eu

. "$(dirname "$(readlink -f "$0")")/usage.sh"
usage_if_requested "${1:-}"

exec config-cli deps install "$@"
