#!/bin/sh
# help: Link the git hooks and put the dispatcher on PATH
#
# usage: config install-hooks
#
# Symlinks tests/pre-commit and tests/pre-push into ~/.cfg/hooks, and this
# directory's dispatcher into ~/.local/bin. Idempotent: running it again
# relinks the same three paths and reports the same three lines.
#
# Takes no options. Refuses to install into a directory that is not owned by
# this user, or that is writable by anyone else.
#
# ---
# The dispatcher execs whatever sits beside it, ~/.local/bin is on PATH, and
# the pre-commit and pre-push hooks run whatever sits in ~/tests, so those
# three directories plus the hooks directory itself are the trust boundary.
# Anyone who can write to them can run code as this user; refuse to install
# into them unless they are owned by this user and writable by nobody else.
set -eu

self=$(readlink -f "$0")
here=$(dirname "$self")

. "$here/usage.sh"
usage_if_requested "${1:-}"

bin_dir="$HOME/.local/bin"
hooks_dir="$HOME/.cfg/hooks"

mkdir -p "$bin_dir"

# `find -L` follows the symlink and tests the directory that will actually be
# written to. Without -L, find stats the LINK rather than the target, and the
# two find implementations then get it wrong in OPPOSITE directions. Measured,
# for a symlink to a 0755 directory and a symlink to a 0777 one:
#
#                          BSD find (macOS)      GNU find (Linux)
#   symlink -> 0755 dir    no match (allows)     MATCHES (refuses)
#   symlink -> 0777 dir    no match (ALLOWS)     matches (refuses)
#
# So on macOS the check lets a world-writable directory through whenever it is
# reached by a link, and on Linux it refuses a directory that is perfectly
# safe. `-L` gives the right answer in all four cells, because it asks about
# the target in every case.
#
# That matters because ~/.local/bin and ~/tests both plausibly arrive as
# symlinks on a synced or restored home, and this function is the whole
# enforcement of the trust boundary the header describes.
check_dir() {
    dir=$1
    if [ -n "$(find -L "$dir" -maxdepth 0 \( -perm -g+w -o -perm -o+w \))" ]; then
        printf 'config install-hooks: refusing, %s is group- or world-writable\n' "$dir" >&2
        exit 1
    fi
    if [ -z "$(find -L "$dir" -maxdepth 0 -user "$(id -un)")" ]; then
        printf 'config install-hooks: refusing, %s is not owned by %s\n' "$dir" "$(id -un)" >&2
        exit 1
    fi
}

if [ ! -d "$hooks_dir" ]; then
    printf 'config install-hooks: no hooks directory at %s (is %s/.cfg the bare repo?)\n' "$hooks_dir" "$HOME" >&2
    exit 1
fi

check_dir "$bin_dir"
check_dir "$here"
check_dir "$HOME/tests"
check_dir "$hooks_dir"

link() {
    ln -sfn "$1" "$2"
    printf '%s -> %s\n' "$2" "$1"
}

link "$HOME/tests/pre-commit" "$hooks_dir/pre-commit"
link "$HOME/tests/pre-push" "$hooks_dir/pre-push"
link "$here/config" "$bin_dir/config"
