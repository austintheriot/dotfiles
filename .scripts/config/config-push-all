#!/bin/sh
# help: Push mac and linux together in one atomic push
#
# usage: config push-all [--dry-run]
#
# Sends both mac and linux to origin in a single atomic push, so the two
# branches land together instead of seconds apart.
#
# Use this instead of two `config push` commands after `config sync`. The
# branch-drift workflow compares origin/mac against origin/linux on every
# push to either branch, so two separate pushes give the first workflow run
# a window in which it sees the new branch and the other branch's previous
# tip, and it fails against that stale ref.
#
# Atomic means the refs land as one transaction: either both move or
# neither does. A rejected mac therefore cannot leave linux pushed on its
# own, which would split the pair this command exists to keep together.
#
# Options:
#   --dry-run   Print the push that would run and send nothing.
#
# Exits 2 on a usage error, otherwise the exit status of the push.
#
# ---
#
# Both branch names are spelled out rather than derived from the checkout.
# The command means "land the pair", and the pair is mac and linux whatever
# is checked out, so running it from home or a feature branch still pushes
# the two branches the drift check compares.
#
# git is invoked through the dispatcher beside this script rather than
# directly, so the bare repo at ~/.cfg is addressed the same way every other
# subcommand addresses it.
set -eu

. "$(dirname "$(readlink -f "$0")")/usage.sh"
usage_if_requested "${1:-}"

usage='usage: config push-all [--dry-run]'
dry_run=''

for arg in "$@"; do
    case $arg in
        --dry-run) dry_run=yes ;;
        *) printf '%s\n' "$usage" >&2; exit 2 ;;
    esac
done

config="$(dirname "$(readlink -f "$0")")/config"

if [ -n "$dry_run" ]; then
    printf 'config push-all: would run git push --atomic origin mac linux\n'
    exit 0
fi

exec "$config" push --atomic origin mac linux
