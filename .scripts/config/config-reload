#!/bin/sh
# help: Reload the tmux config and print the line to re-source zsh
#
# usage: config reload
#
# Re-sources ~/.config/tmux/tmux.conf when run inside tmux, regenerates the
# Alacritty platform config, then prints the line to re-source zsh.
#
# A shim, deliberately. Every decision lives in config-cli, and this file
# exists so `config reload` resolves through the dispatcher rather than
# falling through to git, which would silently become `git reload` (not a
# git verb, so it errors, but a differently-named subcommand could silently
# do something else).
set -eu

. "$(dirname "$(readlink -f "$0")")/usage.sh"
usage_if_requested "${1:-}"

exec config-cli reload "$@"
