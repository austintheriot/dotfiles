#!/bin/sh
# help: Run the test suite, optionally in Docker or in a watch loop
#
# usage: config test [-q|--quiet] [-d|--docker] [-w|--watch] [suite]
#
# Runs every suite in ~/tests by default. Name a suite to run only that one:
# `config test deps-manifest` runs tests/deps-manifest.test.sh.
#
# Options:
#   -q, --quiet    Print only failures and the summary, not every passing
#                  assertion. Honored by the whole-suite run only, so it
#                  cannot be combined with --docker or a suite name.
#   -d, --docker   Run in the Debian container from tests/docker/, the same
#                  image the pre-push hook uses. Slower, and the container has
#                  no repository, so git-dependent assertions skip there.
#   -w, --watch    Rerun after every change to a tracked file. Polls a
#                  checksum once a second. Cannot be combined with --docker,
#                  which would rebuild the image on every keystroke.
#
# Exits 2 on a usage error, otherwise the exit status of the suite.
#
# A shim, deliberately. Every decision lives in config-cli, and this file
# exists so `config test` resolves through the dispatcher rather than
# falling through to git, which would silently become `git test` (not a
# git verb, so it errors, but a differently-named subcommand could silently
# do something else).
set -eu

. "$(dirname "$(readlink -f "$0")")/usage.sh"
usage_if_requested "${1:-}"

exec config-cli test "$@"
