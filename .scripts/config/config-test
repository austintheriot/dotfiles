#!/bin/sh
# help: Run the test suite, optionally in Docker or in a watch loop
#
# usage: config test [-q|--quiet] [-d|--docker] [-w|--watch] [suite]
#
# Runs every suite in ~/tests by default. Name a suite to run only that one:
# `config test check-deps` runs tests/check-deps.test.sh.
#
# Options:
#   -q, --quiet    Print only failures and the summary, not every passing
#                  assertion. Honored by the whole-suite run only, so it
#                  cannot be combined with --docker or a suite name.
#   -d, --docker   Run in the Debian container from tests/docker/, the same
#                  image the pre-push hook uses. Slower, and the container has
#                  no repository, so git-dependent assertions skip there.
#   -w, --watch    Rerun after every change to a tracked file. Polls a
#                  checksum once a second. Cannot be combined with --docker,
#                  which would rebuild the image on every keystroke.
#
# Exits 2 on a usage error, otherwise the exit status of the suite.
set -eu

. "$(dirname "$(readlink -f "$0")")/usage.sh"
usage_if_requested "${1:-}"

usage='usage: config test [-q|--quiet] [-d|--docker] [-w|--watch] [suite]'
quiet=''
docker=''
watch=''
suite=''

for arg in "$@"; do
    case $arg in
        -q|--quiet) quiet=-q ;;
        -d|--docker) docker=yes ;;
        -w|--watch) watch=yes ;;
        -*) printf '%s\n' "$usage" >&2; exit 2 ;;
        *) [ -z "$suite" ] || { printf '%s\n' "$usage" >&2; exit 2; }; suite=$arg ;;
    esac
done

# -q is only honored by run-all.sh, and a watch loop would rebuild the docker
# image on every change, so both combinations are usage errors rather than a
# flag that silently does nothing.
if [ -n "$quiet" ] && { [ -n "$docker" ] || [ -n "$suite" ]; }; then
    printf '%s\n' "$usage" >&2
    exit 2
fi
if [ -n "$watch" ] && [ -n "$docker" ]; then
    printf '%s\n' "$usage" >&2
    exit 2
fi

run_suite() {
    if [ -n "$docker" ]; then
        "$HOME/tests/run-in-docker.sh" ${suite:+"$suite"}
    elif [ -n "$suite" ]; then
        "$HOME/tests/$suite.test.sh"
    else
        "$HOME/tests/run-all.sh" ${quiet:+"$quiet"}
    fi
}

# A cksum over every tracked file's content, tracked only: the worktree is
# the whole home directory, so `ls-files --others` walks all of it and takes
# minutes. Polling is dependency-free on both machines; a real watcher would
# be a platform split.
fingerprint() {
    git --git-dir="$HOME/.cfg" --work-tree="$HOME" ls-files -z --cached \
        | (cd "$HOME" && xargs -0 cksum 2>/dev/null) | cksum
}

if [ -z "$watch" ]; then
    exec_status=0
    run_suite || exec_status=$?
    exit "$exec_status"
fi

# sh runs a trap only after the current command (the sleep) returns, so teardown can take up to one poll interval
trap 'command -v pkill >/dev/null 2>&1 && { pkill -P $$ 2>/dev/null || true; }; exit 143' TERM INT

last=$(fingerprint)
run_suite || true
while :; do
    sleep 1
    current=$(fingerprint)
    if [ "$current" != "$last" ]; then
        last=$current
        run_suite || true
    fi
done
