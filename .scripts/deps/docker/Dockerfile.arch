# Minimal pacman environment for exercising check-deps.sh --fix --yes from
# scratch. Used by ../test-local.sh and by the `arch` leg of
# .github/workflows/deps-check.yml.
#
# Deliberately NOT digest-pinned, unlike Dockerfile.ubuntu. archlinux:base
# is a rolling-release image whose contents track the current Arch
# repositories. A pinned digest goes stale within weeks, and check-deps.sh's
# pacman install commands then run `pacman -Sy` against current mirrors on
# top of an old snapshot -- Arch's documented partial-upgrade breakage,
# which fails with unresolvable library version conflicts rather than a
# clean error. The mutable tag is the correct reference here; the freshness
# of the base image is the property under test.
#
# amd64 only: upstream publishes no arm64 archlinux image. ../test-local.sh
# passes --platform linux/amd64 so this still builds on an Apple Silicon
# machine under emulation. The CI runner is already amd64.
FROM archlinux:base

# The bootstrap's own prerequisites, not dependencies under test. `-Syu`
# rather than `-Sy`: on a rolling-release base, installing against
# refreshed databases without upgrading the already-installed packages is
# the partial-upgrade failure mode Arch warns about.
#
# --disable-sandbox is required to build this image under qemu emulation on
# an arm64 host. pacman 7 drops to an unprivileged `alpm` user and installs
# a seccomp syscall filter for downloads; under emulation the seccomp call
# returns EINVAL and pacman aborts with
# "error restricting syscalls via seccomp: 22!". The flag costs nothing
# here: this container is single-purpose, throwaway, and already running
# every command as root.
RUN pacman -Syu --noconfirm --disable-sandbox sudo curl git wget \
    && pacman -Scc --noconfirm

# The same seccomp problem hits the pacman commands check-deps.sh itself
# runs, and those live in check-deps.sh (shared, cross-platform) where a
# container-emulation workaround does not belong. Disable the sandbox
# image-wide instead, so the engine's unmodified `pacman -Sy ...` works
# here. Without this line every pacman install in the arch container fails
# under emulation and the harness reports a dozen false failures on an
# Apple Silicon machine.
RUN printf 'DisableSandbox\n' >> /etc/pacman.conf

# Only the dependency-checking tree, not the whole dotfiles repo. The repo
# root carries .claude/ and other machine-local content with no business in
# a build context.
COPY .scripts/deps /dotfiles/.scripts/deps
WORKDIR /dotfiles

ENV HOME=/root
# These images verify the shared, cross-platform deps.conf only.
#
# check-deps.sh would otherwise select deps-linux.conf here, which lists
# oh-my-zsh and xclip: real dependencies of the linux machine, but not of
# this container, whose job is the shared manifest. Point DEPS_LOCAL_CONF at
# a path that does not exist -- read_entries() skips a missing file -- so the
# platform variant is excluded without pretending it is empty.
ENV DEPS_LOCAL_CONF=/nonexistent/deps-platform.conf
ENTRYPOINT ["/dotfiles/.scripts/deps/check-deps.sh"]
CMD ["--fix", "--yes"]
