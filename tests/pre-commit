#!/bin/sh
#
# Runs the leak guard before a commit. See tests/leak-check.sh.
#
# Installed for the bare dotfiles repo at ~/.cfg. Git finds it through the
# symlink at ~/.cfg/hooks/pre-commit; core.hooksPath is not set. See the
# install note in ~/.claude/rules/dotfiles-tests.md.
#
# The branch-drift check and the dotfiles test suite run at pre-push instead
# (tests/pre-push): the suite costs ~25s, and paying that once per push beats
# paying it once per commit. The leak guard stays here because a leak should
# never even land in a local commit, not just never reach GitHub.

set -u

if [ ! -x "$HOME/tests/leak-check.sh" ]; then
    printf 'pre-commit: ~/tests/leak-check.sh is missing or not executable\n' >&2
    exit 1
fi

if ! "$HOME/tests/leak-check.sh"; then
    exit 1
fi

printf 'pre-commit: leak check passed\n'
