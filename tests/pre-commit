#!/bin/sh
#
# Runs the dotfiles test suite before a commit that touches tested code.
#
# Installed for the bare dotfiles repo at ~/.cfg. Git finds it through the
# symlink at ~/.cfg/hooks/pre-commit; core.hooksPath is not set. See the install
# note in ~/.claude/rules/dotfiles-tests.md.
#
# The suite only runs when the staged paths include something it covers, so a
# commit that only touches nvim config or a rules markdown file is not delayed.

set -u

TRIGGER_PATHS='^\.my-scripts/.*\.sh$|^\.claude/scripts/.*\.py$|^\.claude/hooks/.*\.sh$|^tests/'

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# Reported on both paths on purpose. A hook that says nothing when it skips is
# indistinguishable from a hook that is not installed at all.
if ! printf '%s\n' "$staged" | grep -qE "$TRIGGER_PATHS"; then
    printf 'pre-commit: no staged path touches tested code, skipping ~/tests/run-all.sh\n'
    exit 0
fi

printf 'pre-commit: staged changes touch tested code, running ~/tests/run-all.sh\n'

if [ ! -x "$HOME/tests/run-all.sh" ]; then
    printf 'pre-commit: ~/tests/run-all.sh is missing or not executable\n' >&2
    exit 1
fi

# GIT_DIR and GIT_WORK_TREE are exported into a hook. The tests build throwaway
# git repositories as fixtures, and with those variables set every `git init`
# and `git commit` inside a fixture would operate on the dotfiles repo instead.
if env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
        "$HOME/tests/run-all.sh" -q; then
    printf 'pre-commit: tests passed\n'
    exit 0
fi

printf '\npre-commit: tests failed, commit blocked.\n' >&2
printf 'Fix the failures, or run `git commit --no-verify` only if you have a\n' >&2
printf 'genuine reason to bypass the gate.\n' >&2
exit 1
