#!/bin/sh
#
# Runs the leak scan, the branch-drift check, and the dotfiles test suite before a push.
#
# Installed for the bare dotfiles repo at ~/.cfg. Git finds it through the
# symlink at ~/.cfg/hooks/pre-push; core.hooksPath is not set. See the
# install note in ~/.claude/rules/dotfiles-tests.md.
#
# The leak guard runs twice: at pre-commit on staged content, and here in
# range mode over every commit being pushed. The push-time scan exists
# because `git commit-tree` (used by `config sync`) and `--no-verify` never
# invoke pre-commit, so a commit can exist locally that no scan has seen.
# The branch-drift check and the full suite run here only, so their cost is
# paid once per push, not once per commit.
#
# The suite runs in Docker (tests/run-in-docker.sh), against the ref being
# pushed rather than the working tree. Requires a running Docker daemon.
#
# Reads git's pre-push stdin protocol: one line per ref being pushed,
# "<local ref> <local sha> <remote ref> <remote sha>".

set -u

zero='0000000000000000000000000000000000000000'
empty_tree='4b825dc642cb6eb9a060e54bf8d69288fbee4904'

# Paths whose edit is worth the Docker suite. A push touching none of them
# skips it, which is what keeps a documentation-only push fast.
#
# The rule for adding one: if a suite READS a path, that path belongs here.
# Otherwise a push editing only that path runs no tests, and the suite that
# reads it fails on somebody else's unrelated push instead. The config trees
# are here for exactly that reason -- tmux-conf-split.test.sh reads
# .config/tmux, and nvim-mason-runtimes.test.sh reads .config/nvim.
#
# container.test.sh asserts each pattern against a real example path, so a
# regex that stops matching fails there rather than silently skipping.
#
# `^\.scripts/` is deliberately extension-free. It used to be
# `^\.scripts/.*\.sh$`, which matched no `config-*` subcommand at all: every
# one of them is extensionless, so a push editing only `config-stamp` or
# `config-build` ran zero tests while config.test.sh and
# config-manifest-lifecycle.test.sh read them both. `setup.sh` and `.zshrc`
# were missing for the same reason, and zshrc-*.test.sh reads the latter.
TRIGGER_PATHS='^\.scripts/|^\.claude/scripts/.*\.py$|^\.claude/hooks/.*\.sh$|^tests/|^\.sync-manifest$|^\.github/workflows/|^crates/|^\.config/nvim/|^\.config/tmux/|^setup\.sh$|^\.zshrc'

pushing_synced_branch=0
changed_paths=''
push_ref=''
push_refs=''
ranges=''

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue

    case $local_ref in
        refs/heads/mac|refs/heads/linux) pushing_synced_branch=1 ;;
    esac

    # The suite runs against the ref being pushed, which is not always the
    # checked-out branch. The first ref is the one the suite runs against;
    # `config push-all` sends mac and linux together, and running the whole
    # suite once per ref would double a push's cost for branches that share
    # almost every tracked file.
    #
    # The stamp check is different and gets every ref (see push_refs below):
    # it is a cheap `rev-parse`, and mac and linux can hold different crate
    # trees, so checking one ref would let a binary that is stale for the
    # other through the gate that exists to catch exactly that.
    [ -z "$push_ref" ] && push_ref=$local_sha
    push_refs="$push_refs $local_sha"

    if [ "$remote_sha" = "$zero" ]; then
        range_paths=$(git diff --name-only "$empty_tree" "$local_sha")
    else
        range_paths=$(git diff --name-only "$remote_sha" "$local_sha")
    fi
    changed_paths="$changed_paths
$range_paths"

    if [ "$remote_sha" = "$zero" ]; then
        ranges="$ranges $empty_tree..$local_sha"
    else
        ranges="$ranges $remote_sha..$local_sha"
    fi
done

# --- leak scan ----------------------------------------------------------
#
# Runs before anything else: a leak must never reach the public remote,
# and this is the last gate before it does. One scan per pushed ref.

if [ ! -x "$HOME/tests/leak-check.sh" ]; then
    printf 'pre-push: ~/tests/leak-check.sh is missing or not executable\n' >&2
    exit 1
fi

range_count=0
for range in $ranges; do
    range_count=$((range_count + 1))
    "$HOME/tests/leak-check.sh" --range "$range"
    leak_status=$?
    if [ "$leak_status" -eq 3 ]; then
        printf '\npre-push: leak check is misconfigured, push blocked.\n' >&2
        exit 1
    elif [ "$leak_status" -eq 2 ]; then
        printf '\npre-push: leak check could not scan %s, push blocked.\n' "$range" >&2
        exit 1
    elif [ "$leak_status" -ne 0 ]; then
        printf '\npre-push: leak check failed for %s, push blocked.\n' "$range" >&2
        exit 1
    fi
done

if [ "$range_count" -eq 0 ]; then
    printf 'pre-push: no pushed range to scan (deletions only)\n'
else
    printf 'pre-push: leak scan passed for %d range(s)\n' "$range_count"
fi

# --- branch-drift check -------------------------------------------------
#
# Only runs when mac or linux is among the pushed refs, so pushing an
# unrelated branch (home, a feature branch) is never blocked by drift
# between two branches it has nothing to do with.
#
# Compares the local mac and linux branches, not their origin/* counterparts,
# so drift is caught from what is about to be pushed rather than from
# whatever either branch looked like at its last fetch. The branch-drift
# GitHub Action re-checks origin/mac against origin/linux after the push, so
# a stale local ref here is a fast pre-flight, not the only gate.

if [ "$pushing_synced_branch" -eq 1 ]; then
    # Every workspace crate is checked against its own subtree, as committed
    # at the ref being pushed. A single workspace-wide stamp would refuse a
    # push over a binary whose own sources did not change, and reading the
    # worktree instead of the ref would compare the binary against whatever
    # happens to be checked out rather than against what is being published.
    #
    # The installed binary does not change between refs, so probing it once
    # per member per ref is 2N spawns where N suffice. Gathered once here,
    # ahead of the ref loop: the installed set belongs to the push, the
    # expected set belongs to each ref.
    #
    # A crate with no src/main.rs is a library: it has no installed binary to
    # gate, and its content is already covered by the stamp of whichever crate
    # depends on it. Detected from the worktree rather than per-ref, since
    # whether a member currently has an installed binary at all is a property
    # of this machine's build, not of any one pushed ref.
    #
    # config-stamp is the copy that ships beside this hook, resolved from the
    # hook's own location rather than $HOME: the two coincide in production
    # (this hook is installed at $HOME/.cfg/hooks, a symlink into the tracked
    # tree), but a test drives the hook against a throwaway fixture repo while
    # $HOME points at a fake home with none of the real tooling under it.
    # DOTFILES_ROOT is pinned to $PWD for the same reason: git invokes this
    # hook with the pushed repo as the working directory, which is $HOME in
    # production and the fixture repo under test.
    hook_dir=$(dirname "$(readlink -f "$0")")
    stamp_cmd="$hook_dir/../.scripts/config/config-stamp"
    BIN_DIR=${CONFIG_BIN_DIR:-$HOME/.local/bin}
    installed_stamps=$(DOTFILES_ROOT="$PWD" "$stamp_cmd" 2>/dev/null) || {
        printf 'pre-push: cannot read workspace members\n' >&2
        exit 1
    }
    [ -n "$installed_stamps" ] || {
        printf 'pre-push: no workspace members, refusing to check nothing\n' >&2
        exit 1
    }

    # Captured through a plain command substitution around the whole loop,
    # not a piped `while`: a piped loop's body runs in a subshell, so any
    # variable it assigns is lost the moment the pipeline ends. Capturing the
    # loop's stdout has no such problem, and IFS/set -f are restored right
    # after the split so they cannot leak into the rest of the hook.
    old_ifs=$IFS
    IFS='
'
    set -f
    installed_report=$(
        for line in $installed_stamps; do
            member=${line%% *}
            [ -n "$member" ] || continue

            if [ ! -f "$PWD/crates/$member/src/main.rs" ]; then
                printf '%s library\n' "$member"
                continue
            fi

            # Absolute path, never PATH resolution: the member name comes
            # from a manifest in the pushed tree, and executing it by name
            # would run whatever answers to that name.
            if [ ! -x "$BIN_DIR/$member" ]; then
                printf '%s missing\n' "$member"
                continue
            fi

            built=$("$BIN_DIR/$member" --stamp)
            printf '%s built %s\n' "$member" "$built"
        done
    )
    set +f
    IFS=$old_ifs

    for ref in $push_refs; do
        pushed_stamps=$(DOTFILES_ROOT="$PWD" "$stamp_cmd" --ref "$ref" 2>/dev/null) || {
            printf 'pre-push: cannot read workspace stamps for %s\n' "$ref" >&2
            exit 1
        }
        [ -n "$pushed_stamps" ] || {
            printf 'pre-push: no workspace members for %s, refusing to check nothing\n' "$ref" >&2
            exit 1
        }

        printf '%s\n' "$pushed_stamps" | while IFS=' ' read -r member expected; do
            [ -n "$member" ] || continue

            status_line=$(printf '%s\n' "$installed_report" | grep -m1 "^$member ")
            case $status_line in
                "$member library")
                    printf 'pre-push: %s is a library for %s, nothing to gate\n' "$member" "$ref"
                    continue
                    ;;
                "$member missing")
                    printf 'pre-push: %s is not installed; run ~/.scripts/config/config-build\n' \
                        "$member" >&2
                    exit 1
                    ;;
                "$member built "*)
                    built=${status_line#"$member built "}
                    ;;
                *)
                    printf 'pre-push: could not determine installed status of %s\n' "$member" >&2
                    exit 1
                    ;;
            esac

            if [ "$built" != "$expected" ]; then
                printf 'pre-push: %s is stale for %s (built %s, expected %s)\n' \
                    "$member" "$ref" "$built" "$expected" >&2
                printf 'pre-push: run ~/.scripts/config/config-build\n' >&2
                exit 1
            fi
            printf 'pre-push: %s stamp matches the pushed crate for %s\n' "$member" "$ref"
        done || exit 1
    done

    if ! config-manifest check mac linux; then
        printf '\npre-push: mac and linux have diverged on a shared path, push blocked.\n' >&2
        printf 'Fix the drift, or run `git push --no-verify` only if you have a\n' >&2
        printf 'genuine reason to bypass the gate.\n' >&2
        exit 1
    fi

    printf 'pre-push: branch-drift check passed\n'
fi

# --- dotfiles test suite -------------------------------------------------
#
# Reported on both paths on purpose. A hook that says nothing when it skips
# is indistinguishable from a hook that is not installed at all.

if ! printf '%s\n' "$changed_paths" | grep -qE "$TRIGGER_PATHS"; then
    printf 'pre-push: no pushed path touches tested code, skipping the suite\n'
    exit 0
fi

printf 'pre-push: pushed changes touch tested code, running the suite in Docker\n'

if [ ! -x "$HOME/tests/run-in-docker.sh" ]; then
    printf 'pre-push: ~/tests/run-in-docker.sh is missing or not executable\n' >&2
    exit 1
fi

# The suite runs in a container, never on this machine. On the host it spawns
# tmux sessions on the real server and writes fixture repos under $HOME,
# which made tmux-update-window-names.test.sh flaky enough to block a push
# whose code was fine. The container is thrown away with its side effects.
#
# There is deliberately no host fallback. Falling back when the daemon is
# down would reintroduce the flake silently, and a gate that quietly changes
# what it tests is worse than one that tells you to start Docker.
#
# GIT_DIR and GIT_WORK_TREE are exported into a hook. The tests build
# throwaway git repositories as fixtures, and with those variables set every
# `git init` and `git commit` inside a fixture would operate on the dotfiles
# repo instead.
if env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
        DOTFILES_TEST_REF="$push_ref" "$HOME/tests/run-in-docker.sh"; then
    printf 'pre-push: tests passed\n'
    exit 0
fi

printf '\npre-push: tests failed, push blocked.\n' >&2
printf 'Fix the failures, or run `git push --no-verify` only if you have a\n' >&2
printf 'genuine reason to bypass the gate.\n' >&2
exit 1
