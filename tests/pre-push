#!/bin/sh
#
# Runs the leak scan, the stamp gate, the Rust checks, and the dotfiles test
# suite before a push.
#
# Installed for the bare dotfiles repo at ~/.cfg. Git finds it through the
# symlink at ~/.cfg/hooks/pre-push; core.hooksPath is not set. See the
# install note in ~/.claude/rules/dotfiles-tests.md.
#
# The leak guard runs twice: at pre-commit on staged content, and here in
# range mode over every commit being pushed. The push-time scan exists
# because `git commit-tree` and `--no-verify` never invoke pre-commit, so a
# commit can exist locally that no scan has seen. The stamp gate, the Rust
# checks, and the full suite run here only, so their cost is paid once per
# push, not once per commit.
#
# The Rust checks (tests/rust-checks.sh) run on the host, ahead of the
# Docker handoff, because they take seconds and the container suite takes
# minutes. The dotfiles test suite itself runs in a container, against the
# ref being pushed rather than the working tree. Requires a running Docker
# daemon.
#
# Reads git's pre-push stdin protocol: one line per ref being pushed,
# "<local ref> <local sha> <remote ref> <remote sha>".

set -u

zero='0000000000000000000000000000000000000000'
empty_tree='4b825dc642cb6eb9a060e54bf8d69288fbee4904'

# Paths whose edit is worth the Docker suite. A push touching none of them
# skips it, which is what keeps a documentation-only push fast.
#
# The rule for adding one: if a test READS a path, that path belongs here.
# Otherwise a push editing only that path runs no tests, and the test that
# reads it fails on somebody else's unrelated push instead. The config trees
# are here for exactly that reason -- tmux-tools' conf_split.rs reads
# .config/tmux, and config-cli's nvim_runtime.rs reads .config/nvim.
#
# container_image.rs asserts each pattern against a real example path, so a
# regex that stops matching fails there rather than silently skipping.
#
# `^deps/` covers the dependency manifests and their harness, which moved out
# from under `^\.scripts/` when deps/ became a top-level directory. Six tests
# read that tree, and the conf files are what `config deps install` acts on, so
# an edit there is the shape this gate exists for. container_image.rs asserts
# the pattern against three real paths under it.
#
# `^\.scripts/` is deliberately extension-free. It used to be
# `^\.scripts/.*\.sh$`, which matched no `config-*` subcommand at all: every
# one of them is extensionless, so a push editing only `config-stamp` or
# `config-build` ran zero tests while config_dispatcher.rs and
# config_manifest_lifecycle.rs read them both. `setup.sh` and `.zshrc` were
# missing for the same reason, and the zshrc_*.rs tests read the latter.
TRIGGER_PATHS='^\.scripts/|^deps/|^\.claude/scripts/.*\.py$|^\.claude/hooks/.*\.sh$|^tests/|^\.github/workflows/|^crates/|^\.config/nvim/|^\.config/tmux/|^setup\.sh$|^\.zshrc'

pushing_branch=0
changed_paths=''
push_ref=''
push_refs=''
ranges=''

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue

    # Any branch push gates on stamps. This used to enumerate
    # refs/heads/mac and refs/heads/linux, so the 2026-09-06 collapse to main
    # silently disabled the whole stamp block below and no test failed: the
    # only suite driving this path fed the hook those two literals. Keying on
    # the ref shape rather than a name means a new branch cannot opt out by
    # not being on a list.
    case $local_ref in
        refs/heads/*) pushing_branch=1 ;;
    esac

    # The suite runs against the ref being pushed, which is not always the
    # checked-out branch. The first ref is the one the suite runs against;
    # several branches can be pushed together in one call, and running the
    # whole suite once per ref would double a push's cost for branches that
    # share almost every tracked file.
    #
    # The stamp check is different and gets every ref (see push_refs below):
    # it is a cheap `rev-parse`, and two pushed refs can hold different crate
    # trees, so checking one ref would let a binary that is stale for the
    # other through the gate that exists to catch exactly that.
    [ -z "$push_ref" ] && push_ref=$local_sha
    push_refs="$push_refs $local_sha"

    # Paths come from `git log --name-only`, which lists what each commit in
    # the range touched, NOT from `git diff`, which lists the net effect.
    #
    # The two disagree whenever a path is added and later deleted inside the
    # range, and leak-check.sh scans per commit on purpose (a secret added in
    # one commit and removed in the next has an empty net diff and is still
    # published). A net-diff path list against a per-commit scan means the
    # scan finds no diff header for a path that no longer exists at the tip,
    # and the guard blocks the push for a path carrying nothing.
    #
    # Measured on this repo's first push of a new branch: the net diff listed
    # 357 paths while the log listed 501, and the 144 extra were files added
    # and later deleted. Every one of them blocked the push.
    if [ "$remote_sha" = "$zero" ]; then
        range_paths=$(git log --format= --name-only "$empty_tree..$local_sha")
    else
        range_paths=$(git log --format= --name-only "$remote_sha..$local_sha")
    fi
    changed_paths="$changed_paths
$range_paths"

    if [ "$remote_sha" = "$zero" ]; then
        ranges="$ranges $empty_tree..$local_sha"
    else
        ranges="$ranges $remote_sha..$local_sha"
    fi
done

# --- leak scan ----------------------------------------------------------
#
# Runs before anything else: a leak must never reach the public remote,
# and this is the last gate before it does. One scan per pushed ref.

if [ ! -x "$HOME/tests/leak-check.sh" ]; then
    printf 'pre-push: ~/tests/leak-check.sh is missing or not executable\n' >&2
    exit 1
fi

range_count=0
for range in $ranges; do
    range_count=$((range_count + 1))
    "$HOME/tests/leak-check.sh" --range "$range"
    leak_status=$?
    if [ "$leak_status" -eq 3 ]; then
        printf '\npre-push: leak check is misconfigured, push blocked.\n' >&2
        exit 1
    elif [ "$leak_status" -eq 2 ]; then
        printf '\npre-push: leak check could not scan %s, push blocked.\n' "$range" >&2
        exit 1
    elif [ "$leak_status" -ne 0 ]; then
        printf '\npre-push: leak check failed for %s, push blocked.\n' "$range" >&2
        exit 1
    fi
done

if [ "$range_count" -eq 0 ]; then
    printf 'pre-push: no pushed range to scan (deletions only)\n'
else
    printf 'pre-push: leak scan passed for %d range(s)\n' "$range_count"
fi

# --- stamp gate -----------------------------------------------------------
#
# Runs whenever a branch is among the pushed refs, which is every ordinary
# push. pre-push compares and refuses; it does not compute.
#
# config-stamp --ref owns the committed side, config-cli verify-stamps owns
# the comparison policy, and neither copy of the workspace member list
# lives here: config-stamp's own output supplies the crate names, and
# verify-stamps reads them from that output. This hook used to spell the
# comparison itself, member by member, with a second copy of "library crates
# have nothing to gate" and "a differing stamp is stale" baked into shell case
# statements.
#
# config-stamp and config-cli are the copies that ship beside this hook,
# resolved from the hook's own location rather than $HOME: the two coincide in
# production (this hook is installed at $HOME/.cfg/hooks, a symlink into the
# tracked tree), but a test drives the hook against a throwaway fixture repo
# while $HOME points at a fake home with none of the real tooling under it.
# DOTFILES_ROOT is pinned to $PWD for the same reason: git invokes this hook
# with the pushed repo as the working directory, which is $HOME in production
# and the fixture repo under test.

if [ "$pushing_branch" -eq 1 ]; then
    hook_dir=$(dirname "$(readlink -f "$0")")
    stamp_cmd="$hook_dir/../.scripts/config/config-stamp"
    BIN_DIR=${CONFIG_BIN_DIR:-$HOME/.local/bin}
    config_cli_bin="$BIN_DIR/config-cli"

    for ref in $push_refs; do
        # A ref with no workspace manifest carries no crates, so there is
        # nothing to gate and no binary to require. Asked here rather than
        # inferred from config-stamp's exit status, which is 2 both for "this
        # ref has no crates/Cargo.toml" and for "the manifest is malformed or
        # names zero members". The second must block the push, so the two
        # cannot share an arm.
        git rev-parse --verify --quiet "$ref:crates/Cargo.toml" >/dev/null \
            || continue

        if [ ! -x "$config_cli_bin" ]; then
            printf 'pre-push: config-cli is not built; run %s\n' \
                "$hook_dir/../.scripts/config/config-build" >&2
            exit 1
        fi

        pushed_stamps=$(DOTFILES_ROOT="$PWD" "$stamp_cmd" --ref "$ref" 2>/dev/null) || {
            printf 'pre-push: cannot read workspace stamps for %s\n' "$ref" >&2
            exit 1
        }
        # No stamps for this ref means it carries no crates, so there is
        # nothing to gate.
        [ -n "$pushed_stamps" ] || continue

        if ! printf '%s\n' "$pushed_stamps" \
            | DOTFILES_ROOT="$PWD" CONFIG_BIN_DIR="$BIN_DIR" \
                "$config_cli_bin" verify-stamps --ref "$ref"; then
            exit 1
        fi
    done

    printf 'pre-push: stamp gate passed\n'
fi

# --- Rust checks -----------------------------------------------------------
#
# Runs on the HOST, before the Docker handoff below, and this is deliberate.
#
# These do NOT duplicate the container leg, even though the container now
# runs cargo too. They run against a `git archive` snapshot of the ref being
# pushed and they run clippy, which the container image deliberately omits:
# its runtime stage installs the toolchain with `--profile minimal` and no
# clippy component, so the lint has no gate inside it.
#
# The container's runtime stage was Rust-free until 70272c37, and this comment
# used to say so. Back then `command -v cargo` was correctly false inside it
# and the shell runner skipped the Rust leg, which is how a push once printed
# "SKIP cargo test (cargo not found)" and passed. That is history now, and it
# is why this host leg exists at all.
#
# This is NOT the host fallback the suite block below rejects. A fallback
# silently substitutes a weaker check when the daemon is down; this always
# runs and never replaces the container leg. The distinction matters because
# the reason the suite wants the container -- the tmux tests spawn sessions on
# the real server, and fixture repos land under $HOME -- does not apply to
# running cargo against a snapshot here. Those crates are pure or test against
# their own temporary directories, verified by running the workspace with HOME
# pointed at an empty directory and finding it still empty afterwards.
#
# Before the Docker block because these take seconds and that takes minutes.

if [ ! -x "$HOME/tests/rust-checks.sh" ]; then
    printf 'pre-push: ~/tests/rust-checks.sh is missing or not executable\n' >&2
    exit 1
fi

# git runs a hook with a minimal PATH that omits ~/.cargo/bin, so rust-checks.sh
# reported "cargo not found" and skipped on machines that do have a toolchain --
# a gate that passed because it measured nothing. Set here rather than inside
# rust-checks.sh: that script must keep taking PATH at its word, because
# crates/config-cli/tests/rust_gate.rs proves the toolchain-less skip by
# running it with PATH=/nonexistent, and a script that reaches past PATH to
# $HOME would make that simulation meaningless.
if [ -x "$HOME/.cargo/bin/cargo" ]; then
    case ":$PATH:" in
        *":$HOME/.cargo/bin:"*) ;;
        *) PATH="$HOME/.cargo/bin:$PATH" ;;
    esac
    export PATH
fi

for ref in $push_refs; do
    if ! "$HOME/tests/rust-checks.sh" "$ref"; then
        printf '\npre-push: Rust checks failed for %s, push blocked.\n' "$ref" >&2
        exit 1
    fi
done

printf 'pre-push: Rust checks passed\n'

# --- dotfiles test suite -------------------------------------------------
#
# Reported on both paths on purpose. A hook that says nothing when it skips
# is indistinguishable from a hook that is not installed at all.

if ! printf '%s\n' "$changed_paths" | grep -qE "$TRIGGER_PATHS"; then
    printf 'pre-push: no pushed path touches tested code, skipping the suite\n'
    exit 0
fi

printf 'pre-push: pushed changes touch tested code, running the suite in Docker\n'

if [ ! -x "$HOME/tests/run-in-docker.sh" ]; then
    printf 'pre-push: ~/tests/run-in-docker.sh is missing or not executable\n' >&2
    exit 1
fi

# The suite runs in a container, never on this machine. On the host it spawns
# tmux sessions on the real server and writes fixture repos under $HOME,
# which made the window-naming tests flaky enough to block a push whose code
# was fine. The container is thrown away with its side effects.
#
# There is deliberately no host fallback. Falling back when the daemon is
# down would reintroduce the flake silently, and a gate that quietly changes
# what it tests is worse than one that tells you to start Docker.
#
# GIT_DIR and GIT_WORK_TREE are exported into a hook. The tests build
# throwaway git repositories as fixtures, and with those variables set every
# `git init` and `git commit` inside a fixture would operate on the dotfiles
# repo instead.
if ! env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
        DOTFILES_TEST_REF="$push_ref" "$HOME/tests/run-in-docker.sh"; then
    printf '\npre-push: tests failed, push blocked.\n' >&2
    printf 'Fix the failures, or run `git push --no-verify` only if you have a\n' >&2
    printf 'genuine reason to bypass the gate.\n' >&2
    exit 1
fi

printf 'pre-push: tests passed\n'

# --- the deep checks: what CI used to carry ------------------------------
#
# The GitHub Actions quota ran out, so these run here now. They are the
# class that has caught the most real bugs: the orphaned nvim runtime tree,
# the missing tree-sitter CLI, the system-wide font path on Arch, and the
# node-on-PATH ordering bug were every one of them invisible to the suite
# above and obvious to a bare container.
#
# Two harnesses, deliberately both, because they have different subjects:
#   test-local.sh     runs `config deps install` against ubuntu, Pop!_OS and
#                     arch images that COPY the deps tree.
#   test-bootstrap.sh runs the REAL entry point -- setup.sh into config init
#                     -- against an image that clones from a bare repo and
#                     has nothing but git, curl and sudo.
# The second is the one that catches a broken bootstrap; the first is the one
# that catches a broken manifest. Neither substitutes for the other.
#
# OPT-OUTABLE ON PURPOSE. Three container bootstraps cost minutes, and an
# unconditional gate that slow is how `--no-verify` becomes a habit -- which
# this repo's rules forbid outright. DOTFILES_SKIP_BOOTSTRAP=1 is the
# deliberate escape, and it prints that it was used so a skipped run is
# never silent.
if [ "${DOTFILES_SKIP_BOOTSTRAP:-0}" = 1 ]; then
    printf 'pre-push: DOTFILES_SKIP_BOOTSTRAP=1, skipping the container bootstraps\n'
    printf 'pre-push: run `deps/test-local.sh` and `deps/test-bootstrap.sh` before\n'
    printf 'pre-push: pushing anything that touches the bootstrap path.\n'
    exit 0
fi

for harness in test-local.sh test-bootstrap.sh; do
    if [ ! -x "$HOME/deps/$harness" ]; then
        printf 'pre-push: ~/deps/%s is missing or not executable\n' "$harness" >&2
        exit 1
    fi
    printf 'pre-push: running deps/%s (minutes; DOTFILES_SKIP_BOOTSTRAP=1 to skip)\n' \
        "$harness"
    if ! env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
            "$HOME/deps/$harness"; then
        printf '\npre-push: %s failed, push blocked.\n' "$harness" >&2
        printf 'This is the gate that catches a broken bootstrap, which the test\n' >&2
        printf 'suite cannot see. Fix it rather than skipping it.\n' >&2
        exit 1
    fi
done

printf 'pre-push: container bootstraps passed\n'
exit 0
