#!/bin/sh
#
# Runs the leak scan, the branch-drift check, and the dotfiles test suite before a push.
#
# Installed for the bare dotfiles repo at ~/.cfg. Git finds it through the
# symlink at ~/.cfg/hooks/pre-push; core.hooksPath is not set. See the
# install note in ~/.claude/rules/dotfiles-tests.md.
#
# The leak guard runs twice: at pre-commit on staged content, and here in
# range mode over every commit being pushed. The push-time scan exists
# because `git commit-tree` (used by `config sync`) and `--no-verify` never
# invoke pre-commit, so a commit can exist locally that no scan has seen.
# The branch-drift check and the full suite run here only, so their cost is
# paid once per push, not once per commit.
#
# The suite runs in Docker (tests/run-in-docker.sh), against the ref being
# pushed rather than the working tree. Requires a running Docker daemon.
#
# Reads git's pre-push stdin protocol: one line per ref being pushed,
# "<local ref> <local sha> <remote ref> <remote sha>".

set -u

zero='0000000000000000000000000000000000000000'
empty_tree='4b825dc642cb6eb9a060e54bf8d69288fbee4904'

TRIGGER_PATHS='^\.scripts/.*\.sh$|^\.claude/scripts/.*\.py$|^\.claude/hooks/.*\.sh$|^tests/|^\.sync-manifest$|^\.github/workflows/'

pushing_synced_branch=0
changed_paths=''
push_ref=''
ranges=''

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue

    case $local_ref in
        refs/heads/mac|refs/heads/linux) pushing_synced_branch=1 ;;
    esac

    # The suite runs against the ref being pushed, which is not always the
    # checked-out branch. Pushing a second ref in one invocation is rare
    # enough that testing the first is the honest simple behavior; the
    # branch-drift Action re-checks both after the push.
    [ -z "$push_ref" ] && push_ref=$local_sha

    if [ "$remote_sha" = "$zero" ]; then
        range_paths=$(git diff --name-only "$empty_tree" "$local_sha")
    else
        range_paths=$(git diff --name-only "$remote_sha" "$local_sha")
    fi
    changed_paths="$changed_paths
$range_paths"

    if [ "$remote_sha" = "$zero" ]; then
        ranges="$ranges $empty_tree..$local_sha"
    else
        ranges="$ranges $remote_sha..$local_sha"
    fi
done

# --- leak scan ----------------------------------------------------------
#
# Runs before anything else: a leak must never reach the public remote,
# and this is the last gate before it does. One scan per pushed ref.

if [ ! -x "$HOME/tests/leak-check.sh" ]; then
    printf 'pre-push: ~/tests/leak-check.sh is missing or not executable\n' >&2
    exit 1
fi

range_count=0
for range in $ranges; do
    range_count=$((range_count + 1))
    "$HOME/tests/leak-check.sh" --range "$range"
    leak_status=$?
    if [ "$leak_status" -eq 2 ]; then
        printf '\npre-push: leak check could not scan %s, push blocked.\n' "$range" >&2
        exit 1
    elif [ "$leak_status" -ne 0 ]; then
        printf '\npre-push: leak check failed for %s, push blocked.\n' "$range" >&2
        exit 1
    fi
done

if [ "$range_count" -eq 0 ]; then
    printf 'pre-push: no pushed range to scan (deletions only)\n'
else
    printf 'pre-push: leak scan passed for %d range(s)\n' "$range_count"
fi

# --- branch-drift check -------------------------------------------------
#
# Only runs when mac or linux is among the pushed refs, so pushing an
# unrelated branch (home, a feature branch) is never blocked by drift
# between two branches it has nothing to do with.
#
# Compares the local mac and linux branches, not their origin/* counterparts,
# so drift is caught from what is about to be pushed rather than from
# whatever either branch looked like at its last fetch. The branch-drift
# GitHub Action re-checks origin/mac against origin/linux after the push, so
# a stale local ref here is a fast pre-flight, not the only gate.

if [ "$pushing_synced_branch" -eq 1 ]; then
    if [ ! -x "$HOME/tests/check-branch-drift.sh" ]; then
        printf 'pre-push: ~/tests/check-branch-drift.sh is missing or not executable\n' >&2
        exit 1
    fi

    if ! "$HOME/tests/check-branch-drift.sh" mac linux; then
        printf '\npre-push: mac and linux have diverged on a shared path, push blocked.\n' >&2
        printf 'Fix the drift, or run `git push --no-verify` only if you have a\n' >&2
        printf 'genuine reason to bypass the gate.\n' >&2
        exit 1
    fi

    printf 'pre-push: branch-drift check passed\n'
fi

# --- dotfiles test suite -------------------------------------------------
#
# Reported on both paths on purpose. A hook that says nothing when it skips
# is indistinguishable from a hook that is not installed at all.

if ! printf '%s\n' "$changed_paths" | grep -qE "$TRIGGER_PATHS"; then
    printf 'pre-push: no pushed path touches tested code, skipping the suite\n'
    exit 0
fi

printf 'pre-push: pushed changes touch tested code, running the suite in Docker\n'

if [ ! -x "$HOME/tests/run-in-docker.sh" ]; then
    printf 'pre-push: ~/tests/run-in-docker.sh is missing or not executable\n' >&2
    exit 1
fi

# The suite runs in a container, never on this machine. On the host it spawns
# tmux sessions on the real server and writes fixture repos under $HOME,
# which made tmux-update-window-names.test.sh flaky enough to block a push
# whose code was fine. The container is thrown away with its side effects.
#
# There is deliberately no host fallback. Falling back when the daemon is
# down would reintroduce the flake silently, and a gate that quietly changes
# what it tests is worse than one that tells you to start Docker.
#
# GIT_DIR and GIT_WORK_TREE are exported into a hook. The tests build
# throwaway git repositories as fixtures, and with those variables set every
# `git init` and `git commit` inside a fixture would operate on the dotfiles
# repo instead.
if env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
        DOTFILES_TEST_REF="$push_ref" "$HOME/tests/run-in-docker.sh"; then
    printf 'pre-push: tests passed\n'
    exit 0
fi

printf '\npre-push: tests failed, push blocked.\n' >&2
printf 'Fix the failures, or run `git push --no-verify` only if you have a\n' >&2
printf 'genuine reason to bypass the gate.\n' >&2
exit 1
